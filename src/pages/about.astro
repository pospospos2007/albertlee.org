---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { SITE, SOCIALS } from '../consts';
---

<BaseLayout
  title="About"
  description="About Albert Lee — software engineer writing about engineering craft, systems, and indie tools."
>
  <section class="section prose">
    <h1>About</h1>
    <p>
      Hi, I&apos;m <strong>{SITE.author}</strong> — a software engineer who enjoys building
      fast, maintainable software and learning in public.
    </p>

    <h2>What this site is for</h2>
    <p>
      <code>albertlee.org</code> is my corner of the internet for long-form technical notes,
      architecture lessons learned in production, and small tools or products I ship along the way.
    </p>
    <ul>
      <li><strong>Engineering notes:</strong> real debugging stories, backend &amp; systems patterns, and performance deep dives.</li>
      <li><strong>Tools &amp; side projects:</strong> utilities built to solve real developer pain points.</li>
      <li><strong>Zero-ops philosophy:</strong> static HTML, Markdown in Git, global CDN, and minimal moving parts.</li>
    </ul>

    <h2>Connect</h2>
    <p>
      The best place to follow what I&apos;m building is on{' '}
      <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a> or via the{' '}
      <a href="/rss.xml">RSS feed</a>.
      {SOCIALS.email && (
        <>
          {' '}For consulting, collaboration, or sponsorships, reach out at{' '}
          <a href={`mailto:${SOCIALS.email}`}>{SOCIALS.email}</a>.
        </>
      )}
    </p>
  </section>

  <NewsletterBox />
</BaseLayout>
