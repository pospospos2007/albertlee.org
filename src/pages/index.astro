---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { PROJECTS, SITE, SOCIALS } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-eyebrow">$ whoami</div>
    <h1>Hi, I&apos;m {SITE.author}.</h1>
    <p class="hero-bio">
      I&apos;m a software engineer. I write about practical engineering, systems design,
      developer tooling, and building lean, useful products on the internet.
    </p>
    <div class="social-row">
      {SOCIALS.github && (
        <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub &rarr;</a>
      )}
      <a href="/rss.xml">RSS Feed &rarr;</a>
      <a href="/about">About &rarr;</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Latest Writing</h2>
      <a href="/blog" class="section-link">All posts &rarr;</a>
    </div>
    <PostList posts={posts} />
  </section>

  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Projects &amp; Tools</h2>
      <a href="/projects" class="section-link">View all &rarr;</a>
    </div>
    <div class="card-grid">
      {PROJECTS.slice(0, 3).map((project) => (
        <a
          href={project.url}
          class="card"
          target={project.url.startsWith('http') ? '_blank' : undefined}
          rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="card-header">
            <h3 class="card-title">{project.name}</h3>
            <span class="badge">{project.status}</span>
          </div>
          <p class="card-desc">{project.description}</p>
          <div class="tag-list">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <NewsletterBox />
</BaseLayout>
