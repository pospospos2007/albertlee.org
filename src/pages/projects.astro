---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../consts';
---

<BaseLayout
  title="Projects"
  description="Open-source software, developer tools, and independent products built by Albert Lee."
>
  <section class="section">
    <h1>Projects &amp; Products</h1>
    <p>
      Tools, experiments, and software I&apos;m building. This page will grow as I ship
      small utilities, open-source packages, and independent web products.
    </p>

    <div class="card-grid" style="margin-top: 1.75rem;">
      {PROJECTS.map((project) => (
        <a
          href={project.url}
          class="card"
          target={project.url.startsWith('http') ? '_blank' : undefined}
          rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="card-header">
            <h2 class="card-title">{project.name}</h2>
            <span class="badge">{project.status}</span>
          </div>
          <p class="card-desc">{project.description}</p>
          <div class="tag-list">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
