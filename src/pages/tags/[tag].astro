---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPublishedPosts, slugifyTag } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);

  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tagName: tag,
      posts: posts.filter((post) =>
        post.data.tags.some((t) => slugifyTag(t) === slug)
      ),
    },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout
  title={`#${tagName}`}
  description={`Articles tagged with #${tagName} on albertlee.org.`}
>
  <section class="section">
    <p style="margin-bottom: 0.4rem;">
      <a href="/blog">&larr; All writing</a>
    </p>
    <h1>#{tagName}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with <code>#{tagName}</code>.</p>
    <PostList posts={posts} showTags={true} />
  </section>
</BaseLayout>
