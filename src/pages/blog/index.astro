---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout
  title="Writing"
  description="Essays, engineering notes, and tutorials on software development and building products."
>
  <section class="section">
    <h1>Writing</h1>
    <p>
      Notes on software engineering, architecture trade-offs, and tools I build along the way.
      Subscribe via <a href="/rss.xml">RSS</a> to get new posts automatically.
    </p>

    {tags.length > 0 && (
      <div class="tag-list" style="margin-top: 1rem; margin-bottom: 1.75rem;">
        {tags.map(({ tag, slug, count }) => (
          <a href={`/tags/${slug}/`} class="tag">
            #{tag} ({count})
          </a>
        ))}
      </div>
    )}

    <PostList posts={posts} showTags={true} />
  </section>
</BaseLayout>
