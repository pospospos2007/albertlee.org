---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../consts';
import { UI, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang].projects;
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.description}>
  <section class="section">
    <h1>{t.title}</h1>
    <p>{t.intro}</p>

    <div class="card-grid" style="margin-top: 1.75rem;">
      {PROJECTS.map((project) => (
        <a
          href={project.url}
          class="card"
          target={project.url.startsWith('http') ? '_blank' : undefined}
          rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="card-header">
            <h2 class="card-title">{project.name}</h2>
            <span class="badge">{project.status[lang]}</span>
          </div>
          <p class="card-desc">{project.description[lang]}</p>
          <div class="tag-list">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
