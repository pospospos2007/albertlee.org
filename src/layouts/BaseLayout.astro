---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { getAlternateUrl, localizedPath, UI, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  alternateUrl?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    tags?: string[];
  };
}

const { lang = 'en', title, description, alternateUrl, article } = Astro.props;
const t = UI[lang];
const metaDescription = description ?? t.siteDescription;
const pageTitle = title ? `${title} — ${t.siteTitle}` : `${t.siteTitle} — ${t.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const resolvedAltPath = getAlternateUrl(lang, Astro.url.pathname, alternateUrl);
const enHref = lang === 'en' ? canonicalURL : new URL(resolvedAltPath, Astro.site);
const zhHref = lang === 'zh' ? canonicalURL : new URL(resolvedAltPath, Astro.site);
const rssPath = localizedPath(lang, '/rss.xml');

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      inLanguage: t.locale,
      headline: title ?? t.siteTitle,
      description: metaDescription,
      url: canonicalURL.toString(),
      datePublished: article.publishedTime,
      ...(article.modifiedTime ? { dateModified: article.modifiedTime } : {}),
      author: {
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      inLanguage: t.locale,
      name: t.siteTitle,
      description: t.siteDescription,
      url: SITE.url,
    };
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.siteTitle} RSS Feed`}
      href={new URL(rssPath, Astro.site)}
    />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content={t.siteTitle} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme init before paint to avoid flash -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} alternateUrl={resolvedAltPath} />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
