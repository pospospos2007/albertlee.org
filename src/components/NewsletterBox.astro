---
import { NEWSLETTER, SOCIALS } from '../consts';
import { localizedPath, UI, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = UI[lang].newsletter;
const rssHref = localizedPath(lang, '/rss.xml');
---

{NEWSLETTER.enabled && (
  <section class="newsletter-box" aria-label={t.heading}>
    <h2>{t.heading}</h2>
    <p>{t.description}</p>

    {NEWSLETTER.actionUrl ? (
      <form
        class="newsletter-form"
        action={NEWSLETTER.actionUrl}
        method="post"
        target="_blank"
      >
        <input
          type="email"
          name={NEWSLETTER.emailFieldName}
          placeholder={t.placeholder}
          required
          aria-label="Email address"
        />
        <button type="submit" class="btn btn-primary">
          {t.buttonLabel}
        </button>
      </form>
    ) : (
      <div class="social-row">
        <a href={rssHref} class="btn btn-primary">{t.rssButton}</a>
        {SOCIALS.github && (
          <a
            href={SOCIALS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            {t.githubButton}
          </a>
        )}
      </div>
    )}
  </section>
)}
