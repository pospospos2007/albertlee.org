---
import { CATEGORY_LABELS, type Lang } from '../i18n';
import { formatDate, getPostUrl, getReadingTime, type BlogPost } from '../utils/posts';

interface Props {
  posts: BlogPost[];
  lang?: Lang;
  showTags?: boolean;
}

const { posts, lang = 'en', showTags = false } = Astro.props;
const labels = CATEGORY_LABELS[lang];
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-item" data-category={post.data.category}>
      <a href={getPostUrl(post)}>
        <div class="post-item-top">
          <h3 class="post-item-title">{post.data.title}</h3>
          <span class="post-item-date">
            {formatDate(post.data.pubDate, lang)} &middot; {getReadingTime(post.body, lang)}
          </span>
        </div>
        <p class="post-item-desc">{post.data.description}</p>
        <div class="tag-list">
          <span class="category-pill">{labels[post.data.category]}</span>
          {showTags &&
            post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
        </div>
      </a>
    </li>
  ))}
</ul>
